---
layout: layouts/base.njk
isNote: true
---
  <main id="main" class="note">
{%- set noteCategory = null %}
{%- for category in noteCategories %}
  {%- if category.title == note.category %}{% set noteCategory = category %}{% endif %}
{%- endfor %}
    <section>
      <h1 class="center">{{ heading or title }}</h1>
{%- if dateText or note.reading_time_text %}
      <p class="note-meta center">{% if dateText %}{{ dateText }}{% endif %}{% if dateText and note.reading_time_text %} · {% endif %}{% if note.reading_time_text %}{{ note.reading_time_text }}{% endif %}</p>
{%- endif %}
{%- if noteCategory %}
      <p class="note-category center">Category: <a href="{{ noteCategory.url }}">{{ noteCategory.title }}</a></p>
{%- endif %}
{%- if note.tags and note.tags.length %}
      <ul class="tag-list note-tags">
{%- for tag in note.tags %}
        <li class="tag">{{ tag }}</li>
{%- endfor %}
      </ul>
{%- endif %}
{%- if note.toc and note.toc.length %}
      <nav class="note-toc" aria-labelledby="note-toc-heading">
        <h2 id="note-toc-heading">On this page</h2>
        <div class="note-reading-progress" data-note-reading-progress hidden>
          <label for="note-reading-progress-value">Reading progress</label>
          <div class="note-reading-progress-row">
            <progress id="note-reading-progress-value" data-note-reading-progress-value max="100" value="0">0%</progress>
            <span data-note-reading-progress-text aria-hidden="true">0%</span>
          </div>
        </div>
        <ol>
{%- for entry in note.toc %}
          <li class="note-toc-level-{{ entry.level }}"><a class="note-toc-link" data-note-toc-link href="#{{ entry.id | urlencode }}">{{ entry.text }}</a></li>
{%- endfor %}
        </ol>
      </nav>
{%- endif %}
      <div class="note-content" data-note-content>
{{ content | safe }}
      </div>
    </section>
{%- set noteNavigation = backendNotes | noteNavigation(note) %}
{%- if noteNavigation.position %}
    <nav class="note-navigation" aria-label="Notes in {{ note.category }}">
      <p class="note-navigation-position">{{ noteNavigation.position }} of {{ noteNavigation.total }} in {% if noteCategory %}<a href="{{ noteCategory.url }}">{{ noteCategory.title }}</a>{% else %}{{ note.category }}{% endif %}</p>
{%- if noteNavigation.previous %}
      <a class="note-navigation-link note-navigation-previous" href="{{ noteNavigation.previous.url }}">
        <span class="note-navigation-direction">Previous</span>
        <span>{{ noteNavigation.previous.title }}</span>
      </a>
{%- endif %}
{%- if noteNavigation.next %}
      <a class="note-navigation-link note-navigation-next" href="{{ noteNavigation.next.url }}">
        <span class="note-navigation-direction">Next</span>
        <span>{{ noteNavigation.next.title }}</span>
      </a>
{%- endif %}
    </nav>
{%- endif %}
{%- set relatedNotes = backendNotes | relatedNotes(note, 5) %}
{%- if relatedNotes.length %}
    <section class="related-notes" aria-labelledby="related-notes-heading">
      <nav class="flex-container section-head notes-head">
        <h2 id="related-notes-heading">Related notes</h2>
      </nav>
      <ol class="related-notes-list">
{%- for related in relatedNotes %}
        <li class="related-note">
          <a href="{{ related.url }}" class="list-row">
            <span class="list-row-main">
              <span class="list-row-title">{{ related.title }}</span>
              <span class="list-row-meta">{{ related.date_text }}</span>
            </span>
            <span class="related-note-tags" aria-label="Shared tags">
{%- for tag in related.sharedTags %}
              <span class="tag">{{ tag }}</span>
{%- endfor %}
            </span>
          </a>
        </li>
{%- endfor %}
      </ol>
    </section>
{%- endif %}
{%- if note.tags and note.tags.length %}
    <section class="graph-section" hidden>
      <nav class="flex-container section-head notes-head">
        <h2>Related graph</h2>
      </nav>
      <div class="knowledge-graph" data-graph-size="local" data-root-slug="{{ note.slug }}" data-graph-src="/graph.json?v={{ backendNotes | graphHash }}"></div>
    </section>
    <script src="/graph.js?v={{ "/graph.js" | assetHash }}" defer></script>
{%- endif %}
  </main>
  <script src="/note-code-copy.js?v={{ "/note-code-copy.js" | assetHash }}" defer></script>
  <script src="/note-reading-progress.js?v={{ "/note-reading-progress.js" | assetHash }}" defer></script>
